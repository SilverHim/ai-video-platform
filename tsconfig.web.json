{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client"
    ],
    "jsx": "react-jsx"
  },
  "include": [
    "src/web/**/*.ts",
    "src/web/**/*.tsx",
    "src/shared/**/*.ts"
  ],
  "exclude": [
    "src/web/**/*.test.ts",
    "src/web/**/*.test.tsx"
  ]
}